{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arx Runa",
  "version": "0.1.0",
  "identifier": "com.arxruna.app",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
        {
        "title": "Arx Runa",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "bin/rclone-x86_64-pc-windows-msvc",
      "bin/rclone-x86_64-unknown-linux-gnu",
      "bin/rclone-aarch64-unknown-linux-gnu",
      "bin/rclone-x86_64-apple-darwin",
      "bin/rclone-aarch64-apple-darwin"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
