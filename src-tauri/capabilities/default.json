{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "allow-list-vaults",
    "allow-authenticate",
    "allow-create-vault",
    "allow-change-password",
    "allow-rotate-key-file",
    "allow-delete-vault",
    "allow-lock-session",
    "allow-get-session-status",
    "allow-list-directory",
    "allow-upload-file",
    "allow-download-file",
    "allow-delete-file",
    "allow-get-file-content",
    "allow-list-remote",
    "allow-flush-epoch-buffer",
    "allow-sync-to-cloud",
    "allow-recover-from-cloud",
    "allow-get-sync-status",
    "allow-migrate-vault",
    "allow-sync-backup",
    "allow-add-destination",
    "allow-list-destinations",
    "allow-delete-destination",
    "allow-export-public-key",
    "allow-add-contact",
    "allow-list-contacts",
    "allow-share-file",
    "allow-import-share",
    "allow-revoke-share",
    "allow-list-shares",
    "allow-list-received-shares",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "rclone",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
