{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "./scripts/hooks/block-pipe-to-shell.sh",
        "powershell": "./scripts/hooks/block-pipe-to-shell.ps1",
        "timeoutSec": 10,
        "comment": "Block curl|sh and wget|sh pipe-to-shell patterns"
      },
      {
        "type": "command",
        "bash": "./scripts/hooks/block-sensitive-files.sh",
        "powershell": "./scripts/hooks/block-sensitive-files.ps1",
        "timeoutSec": 10,
        "comment": "Block access to .env files and secrets/"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "uvx jcodemunch-mcp hook-copilot-posttooluse",
        "powershell": "uvx jcodemunch-mcp hook-copilot-posttooluse",
        "timeoutSec": 30,
        "comment": "Auto-reindex source files after edits"
      },
      {
        "type": "command",
        "bash": "uvx jdocmunch-mcp hook-posttooluse",
        "powershell": "uvx jdocmunch-mcp hook-posttooluse",
        "timeoutSec": 30,
        "comment": "Auto-reindex doc files after edits"
      },
      {
        "type": "command",
        "bash": "./scripts/hooks/run-clippy.sh",
        "powershell": "./scripts/hooks/run-clippy.ps1",
        "timeoutSec": 60,
        "comment": "Run cargo clippy on Rust file edits"
      },
      {
        "type": "command",
        "bash": "./scripts/hooks/run-fmt.sh",
        "powershell": "./scripts/hooks/run-fmt.ps1",
        "timeoutSec": 30,
        "comment": "Run cargo fmt on Rust file edits"
      },
      {
        "type": "command",
        "bash": "./scripts/hooks/copilot-sync-reminder.sh",
        "powershell": "./scripts/hooks/copilot-sync-reminder.ps1",
        "timeoutSec": 10,
        "comment": "Remind about copilot-sync when rules are edited"
      }
    ]
  }
}