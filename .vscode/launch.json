{
    "version": "0.2.0",
    "configurations": [
        {
            // Starts the full app (frontend + backend) without attaching a debugger.
            "name": "[Run] Tauri dev (no debugger)",
            "type": "node-terminal",
            "request": "launch",
            "command": "cargo tauri dev",
            "cwd": "${workspaceFolder}"
        },
        {
            // Starts only the frontend dev server used by Tauri's devUrl.
            "name": "[Run] Frontend dev server (trunk)",
            "type": "node-terminal",
            "request": "launch",
            "command": "trunk serve --port 1420",
            "cwd": "${workspaceFolder}"
        },
        {
            // Debugs native Rust backend code in src-tauri/src/** on Windows.
            // Uses cppvsdbg (ms-vscode.cpptools) — native MSVC PDB reader, no Python LLDB shim.
            // Rust natvis files in .vscode/ provide enum/Vec/String visualization.
            // preLaunchTask starts trunk dev server then builds the binary.
            "name": "[Debug] Backend core (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/arx-runa-tauri.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {"name": "RUST_LOG", "value": "debug"},
                {"name": "RUST_BACKTRACE", "value": "1"}
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/intrinsic.natvis",
            "showDisplayString": true,
            "preLaunchTask": "build:tauri-debug"
        }
    ],
    "compounds": [
        {
            // One-click developer workflow: trunk dev server starts via preLaunchTask inside the debug config.
            "name": "[One-click] Debug UI + Backend (Windows)",
            "configurations": [
                "[Debug] Backend core (Windows)"
            ],
            "stopAll": true
        }
    ]
}