{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-vaults",
    "allow-authenticate",
    "allow-create-vault",
    "allow-change-password",
    "allow-rotate-key-file",
    "allow-delete-vault",
    "allow-lock-session",
    "allow-get-session-status",
    "allow-list-directory",
    "allow-upload-file",
    "allow-download-file",
    "allow-delete-directory",
    "allow-delete-file",
    "allow-get-file-content",
    "allow-list-remote",
    "allow-flush-epoch-buffer",
    "allow-sync-to-cloud",
    "allow-recover-from-cloud",
    "allow-get-sync-status",
    "allow-migrate-vault",
    "allow-sync-backup",
    "allow-pull-and-reconcile",
    "allow-get-backup-health",
    "allow-add-destination",
    "allow-list-destinations",
    "allow-delete-destination",
    "allow-set-primary-destination-cmd",
    "allow-export-public-key",
    "allow-get-own-public-key-b64",
    "allow-add-contact",
    "allow-list-contacts",
    "allow-share-file",
    "allow-import-share",
    "allow-check-share-receipts",
    "allow-download-received-share",
    "allow-revoke-share",
    "allow-recover-vault-from-cloud",
    "allow-list-shares",
    "allow-list-received-shares",
    "allow-compose-email-with-attachment",
    "allow-reveal-in-explorer",
    "allow-begin-google-drive-setup",
    "allow-begin-onedrive-setup",
    "allow-open-url",
    "allow-poll-oauth-setup",
    "allow-has-gdrive-service-account",
    "allow-set-gdrive-service-account",
    "allow-cancel-oauth-setup-cmd",
    "allow-get-received-share-content",
    "allow-setup-recovery",
    "allow-recover-vault-with-phrase",
    "allow-recover-vault-from-cloud-with-phrase",
    "allow-stat-local-path",
    "allow-create-vault-directory",
    "allow-list-local-directory",
    "allow-scan-for-key-file",
    "allow-is-path-on-removable-drive",
    "allow-video-scheme-base-url",
    "allow-prefetch-video",
    "allow-check-cloud-configured",
    "allow-configure-cloud",
    "allow-check-pending-vault-operations",
    "allow-retry-pending-vault-operation",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "rclone",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}