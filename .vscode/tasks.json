{
    "version": "2.0.0",
    "tasks": [
        {
            // Builds the native Tauri binary that the Windows debugger launches.
            "label": "build:tauri-debug",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--manifest-path",
                "src-tauri/Cargo.toml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
