{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arx Runa",
  "identifier": "com.arxruna.desktop",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Arx Runa",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' arxvault: http://arxvault.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Christian Svinding",
    "copyright": "Copyright © 2026 Christian Svinding",
    "category": "Utility",
    "shortDescription": "Zero-knowledge bring-your-own-cloud file encryption",
    "longDescription": "Arx Runa encrypts files client-side before upload; your cloud only ever stores opaque blobs — no keys, names, or metadata.",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "bin/rclone"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERDNERjkwMDE0RDU4ODUKUldTRldFMEJrTi9USFlXd2FnL0FHTVl4eXNHNzlHUkltVnE1WmEyME1vK1E3NUt1WG5KdDhqYW8K",
      "endpoints": [
        "https://github.com/salgaard/arx-runa-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}