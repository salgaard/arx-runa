#!/usr/bin/env bash

# Post-commit hook: creates a report-log stub when src-tauri/src/ modules change.
# The stub is staged for the next commit. Expand it with /report-note <topic>
# or delete it if the commit does not warrant a report entry.
#
# Skip for a specific commit by including [skip-docs] in the commit message.
#
# Setup (run once): git config core.hooksPath .githooks
# On Windows (git bash): chmod +x .githooks/post-commit

COMMIT_MSG=$(git log -1 --pretty=%s)

if echo "$COMMIT_MSG" | grep -q '\[skip-docs\]'; then
    exit 0
fi

CHANGED=$(git diff-tree --no-commit-id -r --name-only HEAD)
SRC_CHANGES=$(echo "$CHANGED" | grep "^src-tauri/src/" || true)

if [ -z "$SRC_CHANGES" ]; then
    exit 0
fi

TAGS=""
MODULES_DISPLAY=""
for module in crypto auth storage ui; do
    if echo "$SRC_CHANGES" | grep -q "src-tauri/src/$module/"; then
        TAGS="${TAGS}${TAGS:+, }\"$module\""
        MODULES_DISPLAY="${MODULES_DISPLAY}${MODULES_DISPLAY:+, }$module"
    fi
done

if [ -z "$TAGS" ]; then
    exit 0
fi

COMMIT_HASH=$(git rev-parse --short HEAD)
TIMESTAMP=$(date '+%Y-%m-%dT%H:%M:%S%z')
FILE_TIMESTAMP=$(date '+%Y-%m-%d-%H%M%S')
SLUG=$(echo "$COMMIT_MSG" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-' | cut -c1-50)
BASENAME="${FILE_TIMESTAMP}-${SLUG}.md"
FILEPATH="docs/report-log/${BASENAME}"

cat > "$FILEPATH" << STUB
---
timestamp: "$TIMESTAMP"
type: implementation
report-sections:
  - analysis
tags: [$TAGS]
source: commit-hook
commit: "$COMMIT_HASH"
---

## $COMMIT_MSG

<!-- Auto-captured from commit: $COMMIT_HASH (modules: $MODULES_DISPLAY) -->
<!-- Expand this stub with: /report-note <topic> -->
<!-- Or delete it if this commit does not warrant a report entry. -->

## Context

## Substance

## Implications
STUB

INDEX="docs/report-log/INDEX.md"
echo "| $(date '+%Y-%m-%d') | implementation | $COMMIT_MSG | analysis | [$BASENAME]($BASENAME) |" >> "$INDEX"

git add "$FILEPATH" "$INDEX"

echo ""
echo "Report stub created: $FILEPATH"
echo "Staged for next commit. Expand with /report-note or delete if not needed."
